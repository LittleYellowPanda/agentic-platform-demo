# Copy this file to .env before the first launch:
#   cp .env.example .env
# The default values work as is for a local run with `docker compose up --build`.
# Never commit .env: it may contain real API keys.

# --- Database (PostgreSQL + pgvector) ---------------------------------------
# Local development credentials. Change them for any shared or exposed setup.
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agent_platform

# --- Frontend ---------------------------------------------------------------
# URL the *browser* uses to reach the API (not the Docker service name).
# Written into the frontend at build time: rebuild the frontend after changing it.
VITE_API_URL=http://localhost:8000

# --- Backend ----------------------------------------------------------------
# Comma-separated list of origins allowed to call the API from a browser (CORS).
CORS_ORIGINS=http://localhost:5173

# --- LLM (Module B) ---------------------------------------------------------
# Any OpenAI-compatible endpoint: OpenRouter (default), Ollama, vLLM, a company gateway.
# Create a key at https://openrouter.ai/keys and put it in your .env, never in Git.
# Leave LLM_API_KEY empty to run in MOCK MODE: rule-based fake answers, no network,
# so the platform starts and can be demoed without any account.
# Local model on Ollama: LLM_BASE_URL=http://<host>:11434/v1, LLM_API_KEY=ollama (any value),
# LLM_MODEL=qwen2.5:7b (the model must support tool calling).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# "openrouter/free" picks a free model supporting tool calling (may change between calls).
# Pin a specific model for reproducible results, e.g. for benchmarks.
LLM_MODEL=openrouter/free

# Extra providers (optional): agents can then pick their models from a dropdown that
# lists every provider's models live (models without tool calling are greyed out).
# Ollama on the Docker host: http://host.docker.internal:11434/v1 (no key needed;
# on Linux this needs extra_hosts "host.docker.internal:host-gateway" on the backend,
# already set in docker-compose.public.yml). Ollama must listen on 0.0.0.0.
OLLAMA_BASE_URL=
# OpenRouter key, if the default provider above is something else (only free models
# with tool calling are listed: 50 requests/day without credits).
OPENROUTER_API_KEY=

# --- External tools ---------------------------------------------------------
# Web search (Tavily, free plan: 1,000 searches/month, no credit card): https://app.tavily.com
# Empty = the web_search tool is shown as unavailable and never offered to agents.
TAVILY_API_KEY=

# --- Public demo only (docker-compose.public.yml, see DEPLOY_PUBLIC.md) ------
# Cloudflare Tunnel token: a secret, never commit it.
CLOUDFLARE_TUNNEL_TOKEN=
